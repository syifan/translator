{
  "name": "live-translator",
  "version": "0.2.0",
  "description": "Live system-audio subtitle translator overlay (Electron + OpenAI Realtime)",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "gen:icons": "node scripts/gen-tray.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sign:setup": "bash scripts/setup-signing.sh",
    "package:dir": "npm run build && electron-builder --mac --dir",
    "package:signed": "npm run build && CSC_NAME=\"Live Translator Dev\" electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "dist:signed": "npm run build && CSC_NAME=\"Live Translator Dev\" electron-builder --mac"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slider": "^1.4.5",
    "@radix-ui/react-switch": "^1.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-audio-loopback": "^1.0.6",
    "lucide-react": "^1.26.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  }
}
